#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/run-in-devcontainer.sh"

rust_pathspecs=('*.rs' 'Cargo.toml' 'Cargo.lock' 'rust-toolchain.toml' 'rustfmt.toml')

echo "${CYAN}[pre-commit]${RESET} triggering..."

# Run Rust quality checks when staged changes touch Rust-relevant files.
# For `git commit --amend` with no staged changes, fall back to files in HEAD
# so message-only amend operations still enforce quality for Rust commits.
staged_rust_changes="$(git diff --cached --name-only -- "${rust_pathspecs[@]}" || true)"
if [[ -z "${staged_rust_changes}" ]]; then
  head_rust_changes="$(git diff-tree --no-commit-id --name-only -r HEAD -- "${rust_pathspecs[@]}" 2>/dev/null || true)"
  if [[ -z "${head_rust_changes}" ]]; then
    exit 0
  fi
  echo "${CYAN}[pre-commit]${RESET} ${YELLOW}no staged Rust changes; enforcing checks for amend based on HEAD files...${RESET}"
else
  echo "${CYAN}[pre-commit]${RESET} Rust-relevant staged changes detected; enforcing checks..."
fi

echo "${CYAN}[pre-commit]${RESET} running make lint..."
if ! run_in_devcontainer "make lint"; then
  echo "${CYAN}[pre-commit]${RESET} ${RED}lint failed. Run make format && make lint, then commit again.${RESET}" >&2
  exit 1
fi

echo "${CYAN}[pre-commit]${RESET} ${GREEN}lint passed.${RESET}"
